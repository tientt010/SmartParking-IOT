# MQTT broker (local Mosquitto on Pi)
MQTT_BROKER=localhost
MQTT_PORT=1883

# IP Webcam app on Android phone
# Open IP Webcam app → Start Server → copy the URL shown
IP_CAM_URL=http://192.168.1.100:8080/shot.jpg
IP_CAM_TIMEOUT=3

# Backend API (local on Pi)
BACKEND_URL=http://localhost:3000

# GPIO pin numbers (BCM mode)
# ── HC-SR04 Ultrasonic Sensors ──────────────────────────────────
# ⚠️  ECHO pins need voltage divider (5V→3.3V): use 1kΩ + 2kΩ resistors
#
# Sensor 1: Entry gate detector
SENSOR1_TRIG=23
SENSOR1_ECHO=24

# Sensor 2: Exit gate detector  
SENSOR2_TRIG=25
SENSOR2_ECHO=8

# Sensor 3-6: Parking slot detectors
SENSOR3_TRIG=12
SENSOR3_ECHO=16

SENSOR4_TRIG=20
SENSOR4_ECHO=21

SENSOR5_TRIG=19
SENSOR5_ECHO=26

SENSOR6_TRIG=13
SENSOR6_ECHO=6

# ── Servo Motors (Barrier) ───────────────────────────────────────
# Connect to GPIO with PWM capability
SERVO1_PIN=18       # Gate 1 (Entry) - hardware PWM0
SERVO2_PIN=17       # Gate 2 (Exit)

# Servo positions (degrees)
SERVO_OPEN_ANGLE=90
SERVO_CLOSE_ANGLE=0

# ── Timing ───────────────────────────────────────────────────────
# How often to read sensors and publish (milliseconds)
SENSOR_PUBLISH_INTERVAL=1.0   # seconds
ENTRY_CHECK_INTERVAL=0.2      # seconds
ENTRY_REARM_DELAY=3.0         # seconds (anti-bounce)

# Detection threshold for entry/exit sensors (cm)
ENTRY_THRESHOLD=4.0           # cm - car detected if distance < this
